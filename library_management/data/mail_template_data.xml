<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_reservation_ready" model="mail.template">
            <field name="name">Library: Reservation Ready for Pickup</field>
            <field name="model_id" ref="model_library_book_reservation"/>
            <field name="subject">Your reserved book is ready for pickup: {{ object.book_id.name }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello {{ object.partner_id.name }},</p>
                    <p>
                        Your reserved copy of "<strong t-out="object.book_id.name"/>" is now
                        ready for pickup at the library.
                    </p>
                    <p>
                        Please pick it up by
                        <strong t-out="format_datetime(object.hold_expiry, tz='UTC', dt_format='medium')"/>,
                        after which the hold will expire and the copy will be offered to the next
                        person in line.
                    </p>
                    <p>Thank you,<br/>The Library Team</p>
                </div>
            </field>
        </record>

        <record id="mail_template_loan_due_reminder" model="mail.template">
            <field name="name">Library: Loan Due-Date Reminder</field>
            <field name="model_id" ref="model_library_book_loan"/>
            <field name="subject">Reminder: "{{ object.book_id.name }}" is due tomorrow</field>
            <field name="email_to">{{ object.borrower_id.email }}</field>
            <field name="use_default_to">False</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.borrower_id.name"/>,</p>
                    <p>
                        This is a reminder that your borrowed copy of
                        "<strong t-out="object.book_id.name"/>" is due back on
                        <strong t-out="format_date(object.due_date)"/>.
                    </p>
                    <p>Thank you,<br/>The Library Team</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
